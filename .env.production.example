APP_NAME=Iziwork
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://iziwork.efspc.inphb.ci
APP_VERSION=1.0.0

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Base de données cPanel ---
# Si "localhost" échoue, essaie DB_HOST=127.0.0.1 (et inversement).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=efspcinphb_iziworkdb
DB_USERNAME=efspcinphb_iziworkuser
DB_PASSWORD=

# --- Sessions ---
# IMPORTANT : driver "file" car aucune migration de table "sessions" n'existe.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# --- Divers ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# L'application n'utilise pas de file d'attente : "sync" évite de lancer un worker.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# --- Téléchargements ZIP ---
# Par défaut : extension "zip" si disponible, sinon repli pur-PHP (ZipStream).
# Mets true pour forcer le repli pur-PHP même si ext-zip est présent.
# ZIP_STREAM_FALLBACK=false

# --- Email (aucun envoi pour l'instant) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@efspc.inphb.ci"
MAIL_FROM_NAME="${APP_NAME}"

# --- Compte admin créé par `php artisan db:seed` ---
# Changez ces valeurs AVANT le seed, puis le mot de passe après la 1re connexion.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@efspc.inphb.ci
ADMIN_PASSWORD=
